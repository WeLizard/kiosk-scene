{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://welizard.dev/schemas/kiosk-scene/scene.schema.json",
  "title": "kiosk-scene scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "rotation",
    "pages"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "defaultDwellSeconds"
      ],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "defaultDwellSeconds": {
          "type": "number",
          "minimum": 5
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "safeArea": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0
            },
            "left": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "layoutPaddingPx": {
          "type": "number",
          "minimum": 0
        },
        "layoutGapPx": {
          "type": "number",
          "minimum": 0
        },
        "globalScale": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "kind",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "overview",
              "cards",
              "forecast+cards",
              "grid",
              "app"
            ]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "cardStyle": {
            "type": "string",
            "enum": [
              "mini",
              "full"
            ]
          },
          "stampCaption": {
            "type": "string"
          },
          "stampValue": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "widget": {
                  "type": "string",
                  "description": "Extension widget id for cards with type 'widget'.",
                  "pattern": "^[a-z][a-z0-9-]{1,31}\\.[a-z0-9][a-z0-9._-]{0,63}$"
                },
                "props": {
                  "type": "object"
                }
              }
            }
          },
          "gridColumns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "gridRows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "app": {
            "type": "string",
            "description": "Extension page id (namespaced, e.g. domovoy.today) mounted into this slide when kind is 'app'.",
            "pattern": "^[a-z][a-z0-9-]{1,31}\\.[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "props": {
            "type": "object",
            "description": "Opaque properties handed to the extension page."
          }
        }
      }
    }
  }
}
