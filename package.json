{
  "name": "kiosk-scene",
  "private": true,
  "version": "0.1.0",
  "description": "Backend-agnostic kiosk scene engine for avatar-driven dashboards",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev:demo": "pnpm --filter @kiosk-scene/demo-generic dev",
    "dev:hosted": "pnpm --filter @kiosk-scene/hosted-runtime dev",
    "build:demo": "pnpm --filter @kiosk-scene/demo-generic build",
    "build:hosted": "pnpm --filter @kiosk-scene/hosted-runtime build",
    "build:domovoy": "pnpm --filter @kiosk-scene/domovoy-ui build",
    "sync:kiosk-addon-runtime": "node ./tools/sync-kiosk-addon-runtime.mjs",
    "validate:kiosk-addon-runtime": "node ./tools/validate-kiosk-addon-runtime.mjs",
    "release:kiosk-addon": "pnpm build:hosted && pnpm build:domovoy && pnpm sync:kiosk-addon-runtime && pnpm validate:kiosk-addon-runtime",
    "preview:demo": "pnpm --filter @kiosk-scene/demo-generic preview",
    "preview:hosted": "pnpm --filter @kiosk-scene/hosted-runtime preview",
    "validate:config": "node ./tools/validate-config.mjs",
    "validate:demo": "node ./tools/validate-demo.mjs",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s kiosk_scene/tests -t kiosk_scene",
    "typecheck:packages": "tsc -p tsconfig.base.json --noEmit",
    "typecheck": "pnpm typecheck:packages && pnpm --filter @kiosk-scene/demo-generic typecheck && pnpm --filter @kiosk-scene/hosted-runtime typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm test:python && pnpm validate:demo && pnpm build:demo && pnpm release:kiosk-addon"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^17",
    "typescript": "^5.8.2",
    "vitest": "^3"
  }
}
